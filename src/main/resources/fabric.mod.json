{
  "schemaVersion": 1,
  "id": "soulsouls",
  "version": "${version}",
  "name": "Soul Souls",
  "description": "An Undertale-inspired Soul system: every player is permanently bound to a Soul with its own colour, difficulty and abilities.",
  "authors": [
    "Kerr227"
  ],
  "contact": {
    "homepage": "https://github.com/Kerr227/soulmod",
    "sources": "https://github.com/Kerr227/soulmod",
    "issues": "https://github.com/Kerr227/soulmod/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.soulsouls.SoulSouls"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
